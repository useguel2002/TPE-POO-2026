<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane stylesheets="@dark-theme.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.Juego_De_La_Vida.JuegoDeLaVidaController">
   <center>
      <StackPane BorderPane.alignment="CENTER">
         <children>
            <GridPane fx:id="grilla" alignment="CENTER" prefHeight="400.0" prefWidth="600.0" />
         </children>
      </StackPane>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="15" styleClass="control-bar">
         <Button fx:id="simularBoton" onAction="#simular" text="Simular" />
         <Button fx:id="pararButton" onAction="#parar" text="Parar" />
         <Button fx:id="sigBoton" onAction="#siguienteGeneracion" text="Siguiente" />
         <Button fx:id="velocidadButton" onAction="#cambiarVelocidad" text="Velocidad" />
         <Label fx:id="labelVel" text="Velocidad: 500ms" />
         <Label fx:id="labelGen" text="Generacion: 0" />
         <Label fx:id="labelEstable" />
      </HBox>
   </bottom>

</BorderPane>
